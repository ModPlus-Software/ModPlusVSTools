<platformUi:DialogWindow
    x:Class="ModPlusVSTools.Localization.UI.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="Импорт строк"
    Width="560"
    Height="480"
    MinWidth="360"
    MinHeight="300"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="NoteText" Grid.Row="0" TextWrapping="Wrap" />

        <TextBox x:Name="InputBox"
                 Grid.Row="1"
                 Margin="0,8,0,8"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="InputBox_OnTextChanged" />

        <CheckBox x:Name="AutoNumerateBox"
                  Grid.Row="2"
                  Margin="0,0,0,8"
                  Content="Автонумерация (имя — следующий номер после последней строки с тем же базовым именем)" />

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.7" Text="Ctrl+Enter — принять" />
            <Button x:Name="OkButton" Width="90" Height="26" Content="Принять" IsEnabled="False" Click="OkButton_OnClick" />
            <Button Width="90" Height="26" Margin="8,0,0,0" Content="Отмена" IsCancel="True" />
        </StackPanel>
    </Grid>
</platformUi:DialogWindow>
