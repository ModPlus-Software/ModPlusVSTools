<platformUi:DialogWindow
    x:Class="ModPlusVSTools.Localization.UI.NewModuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="Новый узел плагина"
    Width="460"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ResizeMode="NoResize">

    <StackPanel Margin="16">
        <TextBlock Margin="0,0,0,4" Text="Программа (префикс файла):" />
        <ComboBox x:Name="ProgramBox" SelectionChanged="ProgramBox_OnSelectionChanged" />

        <TextBlock Margin="0,12,0,4" Text="Уникальное имя плагина (узла):" />
        <TextBox x:Name="NameBox" VerticalContentAlignment="Center" TextChanged="NameBox_OnTextChanged" />

        <TextBlock x:Name="FilesText" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#E04848" TextWrapping="Wrap" />

        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="OkButton" Width="90" Height="26" Content="Создать" IsDefault="True" Click="OkButton_OnClick" />
            <Button Width="90" Height="26" Margin="8,0,0,0" Content="Отмена" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</platformUi:DialogWindow>
