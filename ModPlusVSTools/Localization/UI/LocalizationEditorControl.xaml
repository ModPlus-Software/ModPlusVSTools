<UserControl
    x:Class="ModPlusVSTools.Localization.UI.LocalizationEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:local="clr-namespace:ModPlusVSTools.Localization.UI"
    Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
    Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True">

    <!--  Общие стили (EditorResources.xaml) подключаются в конструкторе до InitializeComponent  -->
    <UserControl.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />

        <!--  Треугольник раскрытия узла дерева  -->
        <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 8 4 L 4 8 Z" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Элемент дерева в цветах темы VS  -->
        <Style x:Key="NavTreeItemBaseStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="PART_Header" Background="Transparent" Padding="1,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Style="{StaticResource TreeExpanderStyle}"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Header" Property="Background" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PART_Header" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemInactiveTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="PART_Header" Property="Background" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemActiveBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:TreeViewColors.SelectedItemActiveTextBrushKey}}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DomainTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource NavTreeItemBaseStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>

        <!--  Заголовок вкладки узла с кнопкой закрытия  -->
        <Style x:Key="ModuleTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Margin="0,0,2,0"
                                Padding="8,4,4,4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                ToolTip="{Binding Module.FullTitle}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{StaticResource ErrorMarkBrush}"
                                         Visibility="{Binding Module.HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Module.Title}" />
                                <Button Margin="6,0,0,0"
                                        Padding="3,0"
                                        Command="{Binding CloseCommand}"
                                        Content="✕"
                                        FontSize="10"
                                        Style="{StaticResource ToolButtonStyle}"
                                        ToolTip="Закрыть вкладку" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.SystemHighlightBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Строки результатов глобального поиска: заголовки узлов и записи  -->
        <ControlTemplate x:Key="SearchHeaderRowTemplate" TargetType="DataGridRow">
            <Border Padding="6,5"
                    Background="{StaticResource SearchHeaderBrush}"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    BorderThickness="0,1,0,1"
                    ToolTip="Двойной щелчок — открыть узел во вкладке «Основное»">
                <TextBlock FontWeight="SemiBold" Text="{Binding HeaderText}" />
            </Border>
        </ControlTemplate>

        <Style x:Key="SearchRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="{Binding Entry.ToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Entry.RowState}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource RowErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Entry.RowState}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource RowWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Entry.RowState}" Value="Marked">
                    <Setter Property="Background" Value="{StaticResource RowMarkedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="Template" Value="{StaticResource SearchHeaderRowTemplate}" />
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Переключение страниц «Основное» / «Поиск». Обе страницы живут постоянно и только
              скрываются: TabControl пересоздавал бы таблицы при каждом переключении  -->
        <DockPanel Grid.Row="0" Margin="4,2,4,0" LastChildFill="False">
            <Button Content="Основное"
                    Command="{Binding ShowMainPageCommand}"
                    Tag="{Binding IsSearchPageActive, Converter={x:Static local:InverseBoolConverter.Instance}}"
                    Style="{StaticResource PageTabStyle}" />
            <Button Content="Поиск"
                    Command="{Binding ShowSearchPageCommand}"
                    Tag="{Binding IsSearchPageActive}"
                    Style="{StaticResource PageTabStyle}" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding OpenSettingsCommand}"
                    Content="Настройки"
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTip="Настройки ModPlus VS Tools (путь к папке исходных файлов локализации)" />
        </DockPanel>

        <!--  Страница «Основное»  -->
        <Grid Grid.Row="1" Visibility="{Binding IsSearchPageActive, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Панель инструментов  -->
            <Border Grid.Row="0"
                    Padding="4,3"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    BorderThickness="0,1,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SaveCommand}" Content="💾 Сохранить" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Сохранить все изменённые узлы в исходные файлы локализации" />
                        <Button Command="{Binding ReloadCommand}" Content="⟳ Обновить" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Перечитать файлы локализации с диска" />
                        <Border Style="{StaticResource ToolSeparatorStyle}" />
                        <Button Command="{Binding InsertBeforeCommand}" Content="Вставить перед" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Вставить пустую строку перед выбранной" />
                        <Button Command="{Binding InsertAfterCommand}" Content="Вставить после" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Вставить строку после выбранной (имя — следующий номер)" />
                        <Button Command="{Binding ImportAfterCommand}" Content="Импорт после" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Импорт строк после выбранной: значения по одному на строку в порядке языков" />
                        <Button Command="{Binding ImportAutoCommand}" Content="Импорт авто" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Автоимпорт строк с тегами &lt;tag&gt;значение&lt;/tag&gt;" />
                        <Border Style="{StaticResource ToolSeparatorStyle}" />
                        <Button Command="{Binding CopyCommand}" Content="Копировать" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Копировать выбранную строку со всеми языками" />
                        <Button Command="{Binding PasteCommand}" Content="Вставить" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Вставить скопированную строку: в выбранную строку, а если строка не выбрана — новой строкой в конец" />
                        <Border Style="{StaticResource ToolSeparatorStyle}" />
                        <Button Command="{Binding RemoveCommand}" Content="Удалить" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Удалить выбранную строку" />
                        <Button Command="{Binding MarkForDeletionCommand}" Content="Пометить на удаление" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Пометить строку комментарием «todo remove after X» или снять пометку" />
                        <Border Style="{StaticResource ToolSeparatorStyle}" />
                        <Button Command="{Binding MoveUpCommand}" Content="▲" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Переместить строку вверх" />
                        <Button Command="{Binding MoveDownCommand}" Content="▼" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Переместить строку вниз" />
                        <Border Style="{StaticResource ToolSeparatorStyle}" />
                    </StackPanel>
                    <DockPanel Margin="4,0,0,0" IsEnabled="{Binding SelectedTab, Converter={x:Static local:NullToBoolConverter.Instance}}">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Поиск:" />
                        <TextBox MinWidth="120"
                                 MaxWidth="400"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SelectedTab.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по текущей таблице: имя ключа и значения всех языков" />
                    </DockPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!--  Дерево узлов  -->
                <DockPanel Grid.Column="0">
                    <TextBox DockPanel.Dock="Top"
                             Margin="4"
                             Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр узлов по имени" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="4">
                        <Button Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                Command="{Binding NewModuleCommand}"
                                Content="＋ Новый узел плагина..."
                                Style="{StaticResource ToolButtonStyle}"
                                BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                        <Button HorizontalAlignment="Stretch"
                                Command="{Binding BuildCommand}"
                                Content="⚙ Собрать"
                                Style="{StaticResource ToolButtonStyle}"
                                BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                ToolTip="Собрать языковые файлы в папку Languages установленного ModPlus (как в ModPlusBuilder и LangFilesEditor). Ход сборки — в окне «Вывод»" />
                    </StackPanel>
                    <TreeView x:Name="NavTree"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{Binding Domains}"
                              ItemContainerStyle="{StaticResource DomainTreeItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="NavTree_OnSelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Modules}" ItemContainerStyle="{StaticResource NavTreeItemBaseStyle}">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding FullTitle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     Fill="{StaticResource ErrorMarkBrush}"
                                                     Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Margin="8,0,6,0" Opacity="0.6" Text="{Binding EntryCount}" />
                                        </Grid>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                              ResizeBehavior="PreviousAndNext" />

                <!--  Вкладки узлов  -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                             ItemContainerStyle="{StaticResource ModuleTabItemStyle}"
                             ItemsSource="{Binding OpenTabs}"
                             SelectedItem="{Binding SelectedTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="Tabs_OnMouseUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!--  Содержимое всех открытых вкладок существует постоянно, неактивные скрыты:
                          переключение вкладок мгновенное и сохраняет прокрутку и выделение  -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding OpenTabs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ModuleView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               Text="Выберите узел в дереве слева"
                               Visibility="{Binding OpenTabs.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                </Grid>
            </Grid>
        </Grid>

        <!--  Страница «Поиск»  -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsSearchPageActive, Converter={StaticResource BoolToVisibility}}">
            <Border DockPanel.Dock="Top"
                    Padding="6"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    BorderThickness="0,1,0,1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Найти:" />
                        <Button DockPanel.Dock="Right" Command="{Binding Search.OpenCommand}" Content="Открыть узел" Style="{StaticResource ToolButtonStyle}"
                                ToolTip="Открыть узел выбранной строки во вкладке «Основное»" />
                        <Button DockPanel.Dock="Right" Command="{Binding Search.CancelCommand}" Content="Отмена" Style="{StaticResource ToolButtonStyle}" />
                        <Button DockPanel.Dock="Right" Command="{Binding Search.SearchCommand}" Content="🔍 Найти" Style="{StaticResource ToolButtonStyle}" />
                        <TextBox x:Name="GlobalSearchBox" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                 Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Search.SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <CheckBox Margin="0,0,16,0" Content="Учитывать регистр" IsChecked="{Binding Search.CaseSensitive}" />
                        <CheckBox Margin="0,0,16,0" Content="Искать в именах ключей" IsChecked="{Binding Search.IncludeNames}" />
                        <CheckBox Content="Искать в атрибутах узлов" IsChecked="{Binding Search.IncludeAttributes}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Opacity="0.75" Text="{Binding Search.Status}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <DataGrid x:Name="SearchGrid"
                      ItemsSource="{Binding Search.Results}"
                      SelectedItem="{Binding Search.SelectedRow}"
                      Style="{StaticResource EntriesGridStyle}"
                      RowStyle="{StaticResource SearchRowStyle}"
                      BeginningEdit="SearchGrid_OnBeginningEdit"
                      MouseDoubleClick="SearchGrid_OnMouseDoubleClick" />
        </DockPanel>

        <!--  Строка состояния  -->
        <Border Grid.Row="2"
                Padding="6,3"
                BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <TextBlock Opacity="0.8" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </Border>
    </Grid>
</UserControl>
