<platformUi:DialogWindow
    x:Class="ModPlusVSTools.UI.ProjectSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="ModPlus — выбор проекта"
    Width="520"
    Height="360"
    MinWidth="400"
    MinHeight="260"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="В решении найдено несколько проектов плагинов. Выберите проект для сборки:"
            TextWrapping="Wrap" />

        <ListBox
            x:Name="ProjectsList"
            Grid.Row="1"
            Margin="0,10,0,10"
            DisplayMemberPath="DisplayName"
            MouseDoubleClick="ProjectsList_OnMouseDoubleClick" />

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                x:Name="OkButton"
                Content="OK"
                Width="90"
                Height="26"
                IsDefault="True"
                Click="OkButton_OnClick" />
            <Button
                Content="Отмена"
                Width="90"
                Height="26"
                Margin="8,0,0,0"
                IsCancel="True" />
        </StackPanel>
    </Grid>

</platformUi:DialogWindow>
